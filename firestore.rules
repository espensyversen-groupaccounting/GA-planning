rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function emailKey() {
      return request.auth.token.email.lower()
        .replace('[.]', '_dot_')
        .replace('@', '_at_');
    }

    function allowedUserPath() {
      return /databases/$(database)/documents/allowedUsers/$(emailKey());
    }

    function isAllowed() {
      return isSignedIn() && exists(allowedUserPath());
    }

    function allowedRole() {
      return get(allowedUserPath()).data.role;
    }

    function isAdmin() {
      return isAllowed() && allowedRole() == 'admin';
    }

    function isAdminOrTeamleder() {
      return isAllowed() && allowedRole() in ['admin', 'teamleder'];
    }

    function isMedlem() {
      return isAllowed() && allowedRole() == 'medlem';
    }

    function ownProfileMatchesAllowlist() {
      return request.resource.data.role == allowedRole()
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower();
    }

    function isOwnAssignedTask() {
      let collaborators = resource.data.get('collaborators', []);
      return resource.data.assignedTo == request.auth.uid
        || (collaborators is list && request.auth.uid in collaborators);
    }

    function isOwnAssignedTodo() {
      return resource.data.assignedTo == request.auth.uid;
    }

    match /allowedUsers/{doc} {
      allow read: if isAllowed();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && (
        isAdmin()
        || (request.auth.uid == userId && ownProfileMatchesAllowlist())
      );
      allow update: if isAllowed() && (
        isAdmin()
        || (request.auth.uid == userId && ownProfileMatchesAllowlist())
      );
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isAllowed();
      allow create: if isAdminOrTeamleder()
        && request.resource.data.name is string
        && request.resource.data.active == true;
      allow update, delete: if isAdminOrTeamleder();
    }

    match /tasks/{taskId} {
      allow read: if isAllowed();
      allow create: if isAdminOrTeamleder();
      allow update: if isAdminOrTeamleder()
        || (
          isMedlem()
          && isOwnAssignedTask()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt',
            'lastEditedBy',
            'clientAppVersion',
            'clientBuild',
            'clientWriteId',
            'writeSchemaVersion'
          ])
        );
      allow delete: if false;
    }

    match /todos/{todoId} {
      allow read: if isAllowed();
      allow create: if isAdminOrTeamleder();
      allow update: if isAdminOrTeamleder()
        || (
          isMedlem()
          && isOwnAssignedTodo()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'completedAt',
            'completedBy',
            'updatedAt',
            'lastEditedBy',
            'clientAppVersion',
            'clientBuild',
            'clientWriteId',
            'writeSchemaVersion'
          ])
        );
      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if isAllowed();
      allow create: if isAllowed()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAllowed()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    match /users/{userId}/notifications/{notifId} {
      allow read, update, delete: if isAllowed()
        && request.auth.uid == userId;
      allow create: if isAllowed();
    }
  }
}
